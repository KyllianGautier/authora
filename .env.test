# E2E test configuration — single source of truth.
# Loaded by global-setup.ts (dotenv) and docker-compose.test.yml (--env-file),
# and by ConfigModule.forRoot() (envFilePath) when the NestJS app boots.
# Changing a port here is enough — no hardcoded values elsewhere.

# Application
NODE_ENV=test
PORT=3000
AUTHORA_BASE_URL=http://localhost:3000

# PostgreSQL — port 25432 to avoid collisions with local services
PG_HOST=127.0.0.1
PG_PORT=25432
PG_USERNAME=test
PG_PASSWORD=test
PG_DATABASE=authora_test

# RabbitMQ — port 25672 to avoid collisions with local services
RABBITMQ_PORT=25672
RABBITMQ_URL=amqp://localhost:25672

# Redis
REDIS_URL=redis://localhost:6379

# Security — minimal Argon2 params for fast test execution
HASH_MEMORY_COST=1024
HASH_TIME_COST=1
HASH_PARALLELISM=1
EMAIL_VERIFICATION_TOKEN_EXPIRATION_SECONDS=86400
ACCOUNT_DELETION_TOKEN_EXPIRATION_SECONDS=3600
TWO_FACTOR_AUTH_VERIFY_TOKEN_EXPIRATION_SECONDS=86400
TWO_FACTOR_AUTH_VALIDATE_TOKEN_EXPIRATION_SECONDS=86400
TWO_FACTOR_AUTH_DISABLING_TOKEN_EXPIRATION_SECONDS=86400
FORGOT_PASSWORD_TOKEN_EXPIRATION_SECONDS=3600
MAGIC_LINK_TOKEN_EXPIRATION_SECONDS=300
AUTH_SESSION_TTL_SEC=600
EXCHANGE_TOKEN_EXPIRATION_SECONDS=300
# JWT_ISSUER=authora
JWT_PRIVATE_KEY_PATH=keys/test-private.pem
JWT_PUBLIC_KEY_PATH=keys/test-public.pem
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_SHORT_EXPIRATION_SECONDS=86400
JWT_REFRESH_TOKEN_LONG_EXPIRATION_SECONDS=2592000
THROTTLE_TTL_SECONDS=60
THROTTLE_ORIGIN_LIMIT=30
THROTTLE_IDENTITY_LIMIT=10
THROTTLE_COMBINED_LIMIT=5

# Password strength — disabled so tests can use simple passwords;
# only PASSWORD_MIN_LENGTH is enforced. Rule-specific coverage lives
# in the unit tests (is-strong-password.spec.ts).
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_DIGIT=false
PASSWORD_REQUIRE_SPECIAL_CHAR=false
PASSWORD_REQUIRE_LOWERCASE=false
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_FORBID_SEQUENTIAL_CHARS=false
PASSWORD_FORBID_REPEATED_CHARS=false
PASSWORD_FORBID_KEYBOARD_SEQUENCE=false
PASSWORD_FORBID_USER_INFO=false
PASSWORD_FORBID_COMMON_PASSWORD=false

# Delay — minimal values to keep tests fast
ENDPOINT_DELAY_MIN_MS=1
ENDPOINT_DELAY_MAX_MS=2
